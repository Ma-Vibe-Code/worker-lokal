# ==============================================================================
# Lightweight Local RTSP-to-MediaMTX Stream Relay Worker Configuration
# ==============================================================================

# Unique Identifier for this Local Relay Worker
WORKER_ID=worker_cabang_01

# Central Backend REST API Endpoint for Camera Bootstrap
# Format: http(s)://<backend-domain-or-ip>:<port>/devices/worker
API_BASE_URL=http://localhost:3001/devices/worker

# API Key Authentication for Central Backend
API_KEY_HEADER=x-api-key
API_KEY=AE6F9iZuCyMpIf4wi7zxA8nSgfONFBXg

# Optional Bearer Token for Backend REST API Authentication (if JWT is required)
API_AUTH_TOKEN=

# MQTT Broker Address for Real-time Event-Driven Synchronization
# Format: tcp://<mqtt-host>:<port> (e.g., tcp://103.xxx.xxx.xxx:1883 or tcp://localhost:1883)
MQTT_BROKER=tcp://localhost:1883

# Optional Custom MQTT Client ID (defaults to WORKER_ID if left empty)
MQTT_CLIENT_ID=worker_cabang_01

# Optional MQTT Broker Authentication Credentials
MQTT_USERNAME=
MQTT_PASSWORD=

# Stream Reconnection Retry Interval in Seconds (when a camera feed disconnects)
RETRY_INTERVAL_SECONDS=5

# Optional Custom Path to FFmpeg Executable (defaults to "ffmpeg" in PATH)
FFMPEG_PATH=ffmpeg
